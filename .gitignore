# ── Java / Maven ──────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Spring / application secrets ──────────────────────────────────────────────
application-local.properties
application-local.yml
application-secret.properties
application-secret.yml
*.env
.env
.env.*
!.env.example

# ── Node / frontend ────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# npm / yarn / pnpm lock files are intentionally kept; only ignore caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

