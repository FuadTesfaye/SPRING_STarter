# Supabase credentials — copy to .env and fill in your values
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — use a strong random value in production
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars

# RabbitMQ (used in docker-compose — defaults work for local dev)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
